
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Local Shop</title>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f8f8f5;
    color: #222;
}

header {
    background: white;
    padding: 18px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 10px #00000010;
    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    font-size: 23px;
    font-weight: bold;
    color: #236b43;
}

.cart-btn {
    background: #236b43;
    color: white;
    border: none;
    padding: 12px 18px;
    border-radius: 25px;
    cursor: pointer;
    font-size: 15px;
}

.hero {
    min-height: 420px;
    background:
    linear-gradient(#0007, #0007),
    url("https://i.ibb.co/yFr0P33p/image.jpg")
    center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    padding: 30px;
}

.hero h1 {
    font-size: clamp(32px, 6vw, 55px);
    margin-bottom: 15px;
}

.hero p {
    font-size: 18px;
    margin-bottom: 25px;
}

.shop-btn {
    display: inline-block;
    background: #f5b942;
    color: #222;
    padding: 14px 30px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: bold;
}

section {
    padding: 55px 6%;
}

.section-title {
    text-align: center;
    font-size: 30px;
    margin-bottom: 30px;
}

.products {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding: 10px 2px 20px;
    scroll-snap-type: x mandatory;
}

.product-card {
    background: white;
    min-width: 230px;
    max-width: 260px;
    flex: 0 0 230px;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 4px 15px #00000012;
    scroll-snap-align: start;
}

.product-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
}

.product-info {
    padding: 18px;
}

.product-info h3 {
    margin-bottom: 10px;
}

.price {
    color: #236b43;
    font-weight: bold;
    font-size: 19px;
    margin-bottom: 15px;
}

.add-btn {
    width: 100%;
    background: #236b43;
    color: white;
    border: none;
    padding: 12px;
    border-radius: 8px;
    cursor: pointer;
}

.add-btn:hover, .cart-btn:hover {
    background: #164b2e;
}

.cart-panel {
    display: none;
    background: white;
    padding: 25px;
    border-radius: 15px;
    margin: 20px auto;
    max-width: 600px;
    box-shadow: 0 4px 20px #00000015;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid #ddd;
    padding: 15px 0;
}

.quantity button {
    padding: 5px 10px;
    cursor: pointer;
}

.remove-btn {
    border: none;
    color: #c33;
    background: none;
    cursor: pointer;
}

.total {
    font-size: 22px;
    font-weight: bold;
    margin: 20px 0;
}

.order-form input {
    width: 100%;
    padding: 14px;
    margin: 10px 0;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 15px;
}

.send-btn {
    width: 100%;
    padding: 15px;
    background: #236b43;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
}

.send-btn:disabled {
    opacity: .6;
    cursor: wait;
}

.whatsapp {
    position: fixed;
    bottom: 22px;
    right: 20px;
    background: #25D366;
    color: white;
    padding: 15px 18px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: bold;
    z-index: 20;
}

footer {
    background: #173e2a;
    color: white;
    text-align: center;
    padding: 25px;
}

@media(max-width:600px) {
    .hero {
        min-height: 350px;
    }

    section {
        padding: 40px 5%;
    }

    .product-card {
        min-width: 210px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">The Local Shop</div>
    <button class="cart-btn" onclick="toggleCart()">
        🛒 Cart (<span id="cart-count">0</span>)
    </button>
</header>

<!-- HERO SECTION -->

<div class="hero">
    <div>
        <h1>Fresh Finds, Best Prices</h1>
        <p>Everything you need, all in one place.</p>
        <a href="#products" class="shop-btn">Shop Now</a>
    </div>
</div>

<!-- PRODUCTS SECTION -->

<section id="products">

    <h2 class="section-title">Our Products</h2>

    <div class="products" id="product-list">

        <div class="product-card">
            <img src="https://i.ibb.co/yFr0P33p/image.jpg"
                 alt="Shop Product">

            <div class="product-info">
                <h3>Shop Product</h3>
                <p class="price">₹50</p>
                <button class="add-btn"
                    onclick="addToCart(1)">
                    Add to Cart
                </button>
            </div>
        </div>

    </div>

</section>

<!-- CART SECTION -->

<div class="cart-panel" id="cart-panel">

    <h2>Your Shopping Cart</h2>

    <div id="cart-items"></div>

    <div class="total">
        Total: ₹<span id="total-price">0</span>
    </div>

    <h3>Customer Details</h3>

    <form class="order-form" id="order-form">

        <input
            type="text"
            id="customer-name"
            placeholder="Your Full Name"
            required>

        <input
            type="tel"
            id="customer-phone"
            placeholder="Your Phone Number"
            pattern="[0-9+ -]{10,15}"
            required>

        <button type="submit" class="send-btn" id="send-btn">
            Send Order
        </button>

    </form>

    <p id="order-status" style="margin-top:15px;"></p>

</div>

<!-- WHATSAPP BUTTON -->

<a class="whatsapp"
   href="https://wa.me/PHONE_NUMBER"
   target="_blank">
   WhatsApp
</a>

<footer>
    <h3>The Local Shop</h3>
    <p>Fresh Finds, Best Prices</p>
    <p>Contact: thelocalshop@gmail.com</p>
    <p>© 2026 The Local Shop. All Rights Reserved.</p>
</footer>

<script>

// PRODUCT DATA

const products = [
    {
        id: 1,
        name: "Shop Product",
        price: 50,
        image: "https://i.ibb.co/yFr0P33p/image.jpg"
    }
];

// CART DATA

let cart = [];

function addToCart(id) {

    const product = products.find(p => p.id === id);

    const existing = cart.find(item => item.id === id);

    if (existing) {
        existing.quantity++;
    } else {
        cart.push({
            ...product,
            quantity: 1
        });
    }

    updateCart();
    alert("Product added to cart!");
}

// CART UPDATE

function updateCart() {

    const count = cart.reduce(
        (sum, item) => sum + item.quantity, 0
    );

    document.getElementById("cart-count").innerText = count;

    const cartItems = document.getElementById("cart-items");

    cartItems.innerHTML = "";

    let total = 0;

    cart.forEach(item => {

        total += item.price * item.quantity;

        const div = document.createElement("div");

        div.className = "cart-item";

        div.innerHTML = `
            <div>
                <strong>${item.name}</strong>
                <p>₹${item.price} each</p>
            </div>

            <div class="quantity">
                <button onclick="changeQuantity(${item.id}, -1)">−</button>
                ${item.quantity}
                <button onclick="changeQuantity(${item.id}, 1)">+</button>
            </div>

            <button class="remove-btn"
                onclick="removeItem(${item.id})">
                Remove
            </button>
        `;

        cartItems.appendChild(div);

    });

    document.getElementById("total-price").innerText = total;
}

// CHANGE QUANTITY

function changeQuantity(id, amount) {

    const item = cart.find(p => p.id === id);

    if (!item) return;

    item.quantity += amount;

    if (item.quantity <= 0) {
        cart = cart.filter(p => p.id !== id);
    }

    updateCart();
}

// REMOVE ITEM

function removeItem(id) {

    cart = cart.filter(item => item.id !== id);

    updateCart();
}

// SHOW / HIDE CART

function toggleCart() {

    const panel = document.getElementById("cart-panel");

    panel.style.display =
        panel.style.display === "block" ? "none" : "block";

    updateCart();

    panel.scrollIntoView({
        behavior: "smooth",
        block: "start"
    });
}

// EMAILJS CONFIGURATION

// Replace these three values with your EmailJS details.

const EMAILJS_PUBLIC_KEY = "YOUR_PUBLIC_KEY";
const EMAILJS_SERVICE_ID = "YOUR_SERVICE_ID";
const EMAILJS_TEMPLATE_ID = "YOUR_TEMPLATE_ID";

emailjs.init({
    publicKey: EMAILJS_PUBLIC_KEY
});

// SEND ORDER

document.getElementById("order-form").addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();

        if (cart.length === 0) {
            alert("Your cart is empty!");
            return;
        }

        const name =
            document.getElementById("customer-name").value.trim();

        const phone =
            document.getElementById("customer-phone").value.trim();

        if (!name || !phone) {
            alert("Please enter your details.");
            return;
        }

        const total = cart.reduce(
            (sum, item) => sum + item.price * item.quantity,
            0
        );

        const orderDetails = cart.map(item =>
            `${item.name} | Quantity: ${item.quantity} | Price: ₹${item.price * item.quantity}`
        ).join("\n");

        const button = document.getElementById("send-btn");
        const status = document.getElementById("order-status");

        button.disabled = true;
        button.innerText = "Sending Order...";

        const templateParams = {
            customer_name: name,
            customer_phone: phone,
            order_items: orderDetails,
            total_price: "₹" + total,
            to_email: "thelocalshop@gmail.com"
        };

        try {

            await emailjs.send(
                EMAILJS_SERVICE_ID,
                EMAILJS_TEMPLATE_ID,
                templateParams
            );

            status.style.color = "green";
            status.innerText = "Order sent successfully!";

            cart = [];
            updateCart();

            document.getElementById("order-form").reset();

        } catch(error) {

            console.error("Email error:", error);

            status.style.color = "red";
            status.innerText =
                "Order could not be sent. Please check EmailJS settings.";

        } finally {

            button.disabled = false;
            button.innerText = "Send Order";

        }

    }
);

</script>

</body>
</html>
